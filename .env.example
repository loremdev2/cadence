[TEMPLATE]
# ---- Postgres (Supabase, database only) ----------------------------------
# Project Settings -> API. Supabase Auth is NOT used: the browser never gets a
# Supabase key, and these two are read on the server only.
SUPABASE_URL=
# Server only. Bypasses RLS, so never expose or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google OAuth (handled directly by this app) -------------------------
# Google Cloud -> APIs & Services -> Credentials -> OAuth client (Web).
# Authorized redirect URI must be <NEXT_PUBLIC_APP_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Sessions and token encryption --------------------------------------
# Signs the session cookie and the OAuth state cookie. 32 random bytes, base64.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
# AES-256-GCM key for stored Google tokens. Also 32 bytes, base64.
# Generate with: openssl rand -base64 32
# Changing it invalidates stored connections (users must reconnect).
TOKEN_ENCRYPTION_KEY=

# ---- OpenRouter ----------------------------------------------------------
# Without a key the app still works: suggestions are computed in code and
# explanations fall back to deterministic copy.
OPENROUTER_API_KEY=
# This one value selects the model for every AI call. Any exact id from
# openrouter.ai/models works; it must support structured outputs. Restart the
# dev server (or redeploy) after changing it.
# Free: particle-ai/particle-1:free   Paid: anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=particle-ai/particle-1:free

# ---- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
